# ==============================================================================
# CONFIGURAÇÕES DO JARVIS SIMPRESS (OPENROUTER)
# ==============================================================================

# Cole aqui a sua chave gerada no https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-coloque-sua-chave-aqui

# URL base da API do OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ==============================================================================
# SELEÇÃO DE MODELOS (Você pode trocar a qualquer momento!)
# ==============================================================================
# Modelos recomendados no OpenRouter:
# 1. deepseek/deepseek-v4.1-flash-1017 -> DeepSeek V4.1 Flash 1017 (Prioridade máxima, ultra-rápido)
# 2. deepseek/deepseek-v4.1-flash      -> DeepSeek V4.1 Flash (Versão padrão estável)
# 3. google/gemini-2.5-flash           -> Gemini 2.5 Flash (Velocidade máxima e ótimo para ferramentas)
# 4. openai/gpt-4o-mini                -> GPT-4o Mini (Extremamente estável e preciso para ferramentas)
# 5. meta-llama/llama-3.3-70b-instruct -> Llama 3.3 70B (Ótimo modelo aberto de ponta)
# 6. anthropic/claude-haiku-5.5:batch  -> Claude Haiku 5.5 Batch (Anthropic)

MODELO_PRINCIPAL=deepseek/deepseek-v4.1-flash-1017

# Modelo de Contingência (Fallback automático se o principal estiver instável ou fora do ar)
MODELO_FALLBACK=google/gemini-2.5-flash

# Critério de escolha do provedor no OpenRouter:
# "throughput" (prioriza velocidade/palavras por segundo - ideal para voz)
# "price" (prioriza o menor custo por token)
# "latency" (prioriza o menor tempo de resposta da 1ª palavra)
ROUTING_SORT=throughput

# ==============================================================================
# INTEGRAÇÃO LOCAL COM O SIMPRESS
# ==============================================================================
# Se o Simpress não responder neste endereço, o Jarvis procura em 127.0.0.1:8000-8099.
SIMPRESS_URL=http://127.0.0.1:8000

# ==============================================================================
# VOZ E ÁUDIO (Microsoft Edge TTS - Gratuito em Português)
# ==============================================================================
HABILITAR_VOZ=true

# Opções de voz em português:
# pt-BR-AntonioNeural   (Masculina, firme e amigável)
# pt-BR-FranciscaNeural (Feminina, natural e clara)
VOZ_NOME=pt-BR-AntonioNeural
